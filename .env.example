# AutoFT-Builder Environment Configuration
# Copy this file to .env and fill in your values

# Required: OpenRouter API key for LLM access
OPENROUTER_API_KEY=your_api_key_here

# OpenRouter API base URL (default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM model to use for generation (default: anthropic/claude-3-haiku)
# See https://openrouter.ai/docs#models for available models
LLM_MODEL=anthropic/claude-3-haiku

# Similarity threshold for deduplication (default: 0.85)
# Range: 0.80 - 0.90 recommended
# Higher = more permissive (allows more similar samples)
# Lower = more strict (filters more aggressively)
SIMILARITY_THRESHOLD=0.85

# Path to SQLite database file (default: data/dataset.db)
DATABASE_PATH=data/dataset.db
